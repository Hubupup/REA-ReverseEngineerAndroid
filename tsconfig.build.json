{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/main.ts",
    "src/cli.ts",
    "src/cliOutput.ts",
    "src/cliBuiltinArguments.ts",
    "src/mcpDoctor.ts"
